{
  "manifest_version": 3,
  "name": "Anti-Dopamine Bar: Socials Only in Socials",
  "version": "0.0.3",
  "description": "Blocks social media and YouTube unless Anti-Dopamine Bar is in Socials.",
  "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "browser_specific_settings": {
    "gecko": { "id": "socials-only@workspace-bar", "strict_min_version": "128.0" }
  }
}
